{
  "name": "personal-website",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "payload": "payload",
    "reinstall": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "start": "next start"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.83.0",
    "@payloadcms/email-resend": "3.83.0",
    "@payloadcms/live-preview-react": "3.83.0",
    "@payloadcms/next": "3.83.0",
    "@payloadcms/plugin-form-builder": "3.83.0",
    "@payloadcms/plugin-nested-docs": "3.83.0",
    "@payloadcms/plugin-redirects": "3.83.0",
    "@payloadcms/plugin-search": "3.83.0",
    "@payloadcms/plugin-seo": "3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@payloadcms/ui": "3.83.0",

    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",

    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "geist": "^1.7.0",
    "graphql": "^16.13.2",
    "lucide-react": "^0.378.0",
    "next": "15.4.11",
    "next-sitemap": "^4.2.3",
    "payload": "3.83.0",
    "payload-admin-bar": "^1.0.7",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.51.0",
    "resend": "^6.12.0",
    "sharp": "0.32.6",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/typography": "^0.5.19",
    "@types/escape-html": "^1.0.4",
    "@types/node": "22.5.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.173.0",
    "autoprefixer": "^10.5.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.4.11",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp"]
  }
}